# Fastlane configuration for Recipe App
# Documentation: https://docs.fastlane.tools/

default_platform(:ios)

# Global variables
APP_IDENTIFIER = "com.recipeapp.mobile"
APP_NAME = "Recipe App"

# iOS Platform
platform :ios do
  desc "Build the iOS app"
  lane :build do
    setup_ci if ENV['CI']
    
    # Import certificates and provisioning profiles
    import_certificate(
      certificate_path: "Certificates.p12",
      certificate_password: ENV['CERTIFICATE_PASSWORD']
    ) if ENV['CERTIFICATE_PASSWORD']
    
    # Update provisioning profile
    update_project_provisioning(
      xcodeproj: "mobile/ios/App/App.xcodeproj",
      build_configuration: "Release",
      profile: ENV['PROVISIONING_PROFILE_PATH']
    ) if ENV['PROVISIONING_PROFILE_PATH']
    
    # Build the app
    build_app(
      workspace: "mobile/ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "RecipeApp.ipa",
      clean: true,
      include_bitcode: false,
      export_options: {
        "method" => "app-store",
        "teamID" => ENV['APPLE_TEAM_ID'],
        "uploadBitcode" => false,
        "uploadSymbols" => true,
        "compileBitcode" => false
      }
    )
  end
  
  desc "Deploy to TestFlight"
  lane :beta do
    setup_ci if ENV['CI']
    
    # Build first if IPA doesn't exist
    build unless File.exist?("./build/RecipeApp.ipa")
    
    # Upload to TestFlight
    pilot(
      api_key_path: "AuthKey.p8",
      api_key: {
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_filepath: "AuthKey.p8"
      },
      ipa: "./build/RecipeApp.ipa",
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      changelog: ENV['RELEASE_NOTES'] || "Bug fixes and improvements",
      distribute_external: false,
      groups: ["Internal Testing"]
    )
    
    # Send notification
    slack(
      message: "🍎 iOS app uploaded to TestFlight successfully!",
      channel: "#releases",
      success: true
    ) if ENV['SLACK_URL']
  end
  
  desc "Deploy to App Store"
  lane :release do
    setup_ci if ENV['CI']
    
    # Build first if IPA doesn't exist
    build unless File.exist?("./build/RecipeApp.ipa")
    
    # Upload to App Store
    deliver(
      api_key_path: "AuthKey.p8",
      api_key: {
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_filepath: "AuthKey.p8"
      },
      ipa: "./build/RecipeApp.ipa",
      app_identifier: APP_IDENTIFIER,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true
    )
    
    slack(
      message: "🚀 iOS app uploaded to App Store successfully!",
      channel: "#releases",
      success: true
    ) if ENV['SLACK_URL']
  end
end

# Android Platform
platform :android do
  desc "Deploy to Google Play Store"
  lane :release do
    # Build the AAB with Gradle
    gradle(
      task: ":app:bundle",
      build_type: "Release",
      project_dir: "../mobile/android"
    )

    # Path to AAB file
    aab_path = "../mobile/android/app/build/outputs/bundle/release/app-release.aab"
    
    unless File.exist?(aab_path)
      UI.user_error!("AAB file not found at #{aab_path}. Make sure to build with Capacitor first.")
    end
    
    # Upload to Google Play
    supply(
      package_name: APP_IDENTIFIER,
      aab: aab_path,
      track: "internal", # Start with internal testing
      release_status: "draft", # Keep as draft for manual review
      json_key: "play-service-account.json",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: true
    )
    
    slack(
      message: "🤖 Android app uploaded to Google Play (Internal Testing) successfully!",
      channel: "#releases", 
      success: true
    ) if ENV['SLACK_URL']
  end
  
  desc "Promote to production"
  lane :promote_to_production do
    supply(
      package_name: APP_IDENTIFIER,
      track: "internal",
      track_promote_to: "production",
      json_key: "play-service-account.json",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    
    slack(
      message: "🎉 Android app promoted to production successfully!",
      channel: "#releases",
      success: true
    ) if ENV['SLACK_URL']
  end
end

# Error handling
error do |lane, exception|
  slack(
    message: "❌ Error in lane #{lane}: #{exception.message}",
    channel: "#releases",
    success: false
  ) if ENV['SLACK_URL']
end
